def calcular_imc(peso, altura):
     return (peso / altura)**2

peso = float(input('Informe seu peso: '))
altura = float(input('Informe sua altura: '))
valor_imc = calcular_imc(peso, altura)
print('Seu imc é: ', valor_imc)









     
